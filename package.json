{
  "name": "@local/dsh-background",
  "version": "1.0.0",
  "private": true,
  "description": "Custom background picture for the DeepSeek Harness Web GUI: a window-wide picture under a theme-colored wash, with tunable strength and blur.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baicheng2333/dsh-background.git"
  },
  "homepage": "https://github.com/baicheng2333/dsh-background#readme",
  "bugs": {
    "url": "https://github.com/baicheng2333/dsh-background/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "background",
    "theme"
  ]
}
